# --- Postgres ---
POSTGRES_USER=sigforge
POSTGRES_PASSWORD=sigforge
POSTGRES_DB=sigforge
DATABASE_URL=postgresql://sigforge:sigforge@localhost:5432/sigforge?schema=public

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- API ---
API_PORT=4000
PUBLIC_ASSET_BASE_URL=http://localhost:4000
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Storage (local filesystem for MVP) ---
STORAGE_DIR=./storage

# --- Animation provider ---
# Which adapter to use: "local" (server-side GIF) or "external" (stub for future AI)
ANIMATION_PROVIDER=local
EXTERNAL_ANIMATION_API_KEY=

# --- Web (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:4000
